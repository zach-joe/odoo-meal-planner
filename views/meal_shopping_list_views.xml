<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="meal_shopping_list_list" model="ir.ui.view">
    <field name="name">meal.shopping.list.list</field>
    <field name="model">meal.shopping.list</field>
    <field name="arch" type="xml">
      <list string="My Shopping List">
        <field name="week" />
        <field name="produce_id" string="Product" />
        <field name="quantity" />
        <field name="unit" />
        <field name="recipe_ids" />
      </list>
    </field>
  </record>

  <record id="meal_shopping_list_action" model="ir.actions.act_window">
    <field name="name">My Shopping List</field>
    <field name="res_model">meal.shopping.list</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>