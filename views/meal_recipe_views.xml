<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="meal_recipe_list" model="ir.ui.view">
    <field name="name">meal.recipe.list</field>
    <field name="model">meal.recipe</field>
    <field name="arch" type="xml">
      <list string="My Recipes">
        <field name="name" string="Recipe Name" />
      </list>
    </field>
  </record>

  <record id="meal_recipe_form" model="ir.ui.view">
    <field name="name">meal.recipe.form</field>
    <field name="model">meal.recipe</field>
    <field name="arch" type="xml">
      <form string="Recipe Form">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" /></h1>
          </div>
          <group>
            <field name="description"/>
          </group>
          <notebook>
            <page string="Ingredients">
              <field name="ingredient_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="meal_recipe_ingredient_list" model="ir.ui.view">
    <field name="name">meal.recipe.ingredient.list</field>
    <field name="model">meal.recipe.ingredient</field>
    <field name="arch" type="xml">
      <list string="Ingredients">
        <field name="produce_id" string="Ingredient Name" />
        <field name="quantity" />
        <field name="unit" string="Unit" />
      </list>
    </field>
  </record>

  <record id="meal_recipe_ingredient_form" model="ir.ui.view">
    <field name="name">meal.recipe.ingredient.form</field>
    <field name="model">meal.recipe.ingredient</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="produce_id" string="Ingredient Name" />
            <field name="description" />
            <field name="quantity" />
            <field name="is_staple" invisible="True" />
            <field name="unit" readonly="not is_staple" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="meal_recipe_action" model="ir.actions.act_window">
    <field name="name">Recipes</field>
    <field name="res_model">meal.recipe</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>